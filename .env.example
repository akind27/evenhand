# Copy to .env.local and fill in. Leave a value empty to use demo mode for that part.
# Keyless demo mode is for local runs. On Vercel the app refuses to start its routes without the PayPal
# sandbox keys and BLOB_READ_WRITE_TOKEN, and says which one is missing.

# PayPal environment. The app only accepts "sandbox". Live is refused.
PAYPAL_ENV=sandbox
# PayPal sandbox REST app client ID (server side).
PAYPAL_CLIENT_ID=
# PayPal sandbox REST app client secret (server side). Never commit.
PAYPAL_CLIENT_SECRET=
# The browser checkout button gets the same client ID from /api/mode, so no public variable is needed.
# Anthropic API key for the photo assessor. Empty means recorded answers.
ANTHROPIC_API_KEY=
# Vercel Blob read-write token for evidence storage. Empty means local files.
BLOB_READ_WRITE_TOKEN=
# Optional. Base URL used in links sent to renters and shops. Empty: the site the shop is using.
PUBLIC_BASE_URL=
# Maximum AI calls per day across the app.
AI_DAILY_CALL_LIMIT=300
